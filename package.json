{
  "name": "opencode-llama-swap-variants",
  "version": "0.1.0",
  "description": "OpenCode plugin: turns llama-swap's advertised reasoning efforts into model variants",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "prepublishOnly": "npm run build && bun test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "llama-swap",
    "llama.cpp"
  ],
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NubeBuster/opencode-llama-swap-variants.git"
  },
  "homepage": "https://github.com/NubeBuster/opencode-llama-swap-variants#readme",
  "bugs": {
    "url": "https://github.com/NubeBuster/opencode-llama-swap-variants/issues"
  },
  "engines": {
    "opencode": ">=1.18.29"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
